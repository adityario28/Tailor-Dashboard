---
import AdminLayout from "@/layouts/adminLayout.astro";
import { Button } from "@/components/ui/button";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";
import OrdersTable from "@/components/OrdersTable";
import DashboardMetrics from "@/components/DashboardMetrics";
import { Skeleton } from "@/components/ui/skeleton";
---

<AdminLayout title="Dashboard">
  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-950">
          Dashboard
        </h1>
        <p class="text-slate-500 mt-1">Selamat datang di Tailor App</p>
      </div>
      <div class="flex gap-2 self-start sm:self-auto">
        <a href="/new-group-order">
          <Button
            variant="outline"
            className="h-12 px-4 text-base font-semibold gap-2 border-indigo-200 text-indigo-600 hover:bg-indigo-50"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            Pesanan Grup
          </Button>
        </a>
        <a href="/new-order">
          <Button
            className="h-12 px-6 text-base font-semibold bg-indigo-600 hover:bg-indigo-700 gap-2"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 5v14M5 12h14"></path>
            </svg>
            Tambah Pesanan
          </Button>
        </a>
      </div>
    </div>

    <!-- Astro skeleton for metrics (shows until React has data) -->
    <div id="metrics-skeleton" class="grid grid-cols-1 md:grid-cols-3 gap-4 pb-4">
      <Card>
        <CardHeader>
          <CardTitle class="text-sm font-medium text-slate-500">Total Pesanan</CardTitle>
        </CardHeader>
        <CardContent><Skeleton className="h-10 w-16" /></CardContent>
      </Card>
      <Card>
        <CardHeader>
          <CardTitle class="text-sm font-medium text-slate-500">Sedang Dikerjakan</CardTitle>
        </CardHeader>
        <CardContent><Skeleton className="h-10 w-16" /></CardContent>
      </Card>
      <Card>
        <CardHeader>
          <CardTitle class="text-sm font-medium text-slate-500">Selesai</CardTitle>
        </CardHeader>
        <CardContent><Skeleton className="h-10 w-16" /></CardContent>
      </Card>
    </div>
    <!-- React metrics (hidden until data ready) -->
    <div id="metrics-react" style="display: none;">
      <DashboardMetrics client:only="react" />
    </div>

    <!-- Astro skeleton for table (shows until React has data) -->
    <Card id="table-skeleton" className="overflow-hidden">
      <CardHeader><CardTitle>Daftar Pesanan</CardTitle></CardHeader>
      <CardContent className="p-0">
        <div class="overflow-x-auto">
          <table class="w-full text-sm min-w-[700px]">
            <thead>
              <tr class="border-b text-slate-500 text-left">
                <th class="pb-3 pl-4 sm:pl-6 font-medium">Nama Pelanggan</th>
                <th class="pb-3 font-medium">Jenis</th>
                <th class="pb-3 font-medium">Penjahit</th>
                <th class="pb-3 font-medium">Tanggal Order</th>
                <th class="pb-3 font-medium">Status Bayar</th>
                <th class="pb-3 pr-4 sm:pr-6 font-medium">Status</th>
              </tr>
            </thead>
            <tbody>
              {[...Array(5)].map((_, i) => (
                <tr class="border-b">
                  <td class="py-3 pl-4 sm:pl-6"><Skeleton className="h-5 w-32" /></td>
                  <td class="py-3"><Skeleton className="h-5 w-24" /></td>
                  <td class="py-3"><Skeleton className="h-5 w-20" /></td>
                  <td class="py-3"><Skeleton className="h-5 w-28" /></td>
                  <td class="py-3"><Skeleton className="h-6 w-20 rounded-full" /></td>
                  <td class="py-3 pr-4 sm:pr-6"><Skeleton className="h-6 w-24 rounded-full" /></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </CardContent>
    </Card>
    <!-- React table (hidden until data ready) -->
    <div id="table-react" style="display: none;">
      <Card className="overflow-hidden">
        <CardHeader><CardTitle>Daftar Pesanan</CardTitle></CardHeader>
        <CardContent className="p-0">
          <OrdersTable client:only="react" />
        </CardContent>
      </Card>
    </div>
  </div>

  <script>
    // Swap Astro skeletons with React components when data is ready
    window.addEventListener('metrics-ready', () => {
      document.getElementById('metrics-skeleton')?.style.setProperty('display', 'none');
      document.getElementById('metrics-react')?.style.setProperty('display', 'block');
    });
    window.addEventListener('table-ready', () => {
      document.getElementById('table-skeleton')?.style.setProperty('display', 'none');
      document.getElementById('table-react')?.style.setProperty('display', 'block');
    });
  </script>
</AdminLayout>
